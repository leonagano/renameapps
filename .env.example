# Neon Postgres connection string. Omit for local dev — the app falls back
# to an in-memory store seeded with the default apps (data resets on restart).
DATABASE_URL=

# Salt used when hashing visitor IPs before storing them (rate limiting).
# Set this to a long random string in production.
IP_HASH_SALT=

# Shared secret configured on the Tally webhook, used to verify the
# Tally-Signature header on POST /api/webhooks/tally. Optional but recommended.
TALLY_WEBHOOK_SECRET=
